# ==========================================
# Infrastructure (Terraform)
# ==========================================
# Block the entire .terraform folder containing provider binaries
**/.terraform/

# Block state files which can contain secrets
*.tfstate
*.tfstate.*

# Crash logs and variables
crash.log
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration credentials
.terraformrc
terraform.rc

